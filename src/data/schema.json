{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tu Hora Divina episode catalog",
  "description": "Episodes grouped by website season, then by the twelve month labels each season is presented under. For Temporada 1 those labels match the 2014 air dates; for Temporada 2 they are grouping labels only and carry no calendar meaning.",
  "type": "object",
  "required": ["fourteen", "seasonTwo"],
  "additionalProperties": { "$ref": "#/$defs/season" },
  "properties": {
    "fourteen": { "$ref": "#/$defs/season" },
    "seasonTwo": { "$ref": "#/$defs/season" }
  },
  "$defs": {
    "season": {
      "type": "object",
      "required": ["seasonNumber", "seasonTitle", "allMonths", "monthsData"],
      "properties": {
        "seasonNumber": { "type": "integer", "minimum": 1 },
        "seasonTitle": { "type": "string", "minLength": 1 },
        "allMonths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/monthName" }
        },
        "monthsData": {
          "type": "object",
          "required": [
            "enero",
            "febrero",
            "marzo",
            "abril",
            "mayo",
            "junio",
            "julio",
            "agosto",
            "septiembre",
            "octubre",
            "noviembre",
            "diciembre"
          ],
          "propertyNames": { "$ref": "#/$defs/monthName" },
          "additionalProperties": { "$ref": "#/$defs/month" }
        }
      }
    },
    "monthName": {
      "type": "string",
      "enum": [
        "enero",
        "febrero",
        "marzo",
        "abril",
        "mayo",
        "junio",
        "julio",
        "agosto",
        "septiembre",
        "octubre",
        "noviembre",
        "diciembre"
      ]
    },
    "month": {
      "type": "object",
      "required": ["monthTitle", "audioData"],
      "properties": {
        "monthTitle": { "type": "string" },
        "audioData": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/episode" }
        }
      }
    },
    "episode": {
      "type": "object",
      "required": [
        "episodeNumber",
        "season",
        "audioTitle",
        "date",
        "description",
        "audioFile",
        "slug"
      ],
      "properties": {
        "episodeNumber": {
          "description": "Global across the whole catalog, 1-74. Not restarted per season.",
          "type": "integer",
          "minimum": 1,
          "maximum": 74
        },
        "season": {
          "description": "Website season only. Spotify treats all 74 episodes as one season.",
          "type": "integer",
          "enum": [1, 2]
        },
        "audioTitle": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": { "type": "string", "minLength": 1 },
        "audioFile": { "type": "string", "pattern": "^https://" },
        "slug": { "type": "string", "pattern": "^[0-9a-z-]+$" },
        "duration": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
        "spotifyUrl": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
