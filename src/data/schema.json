{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tu Hora Divina episode catalog",
  "type": "object",
  "required": ["fourteen"],
  "additionalProperties": { "$ref": "#/$defs/year" },
  "properties": {
    "fourteen": { "$ref": "#/$defs/year" }
  },
  "$defs": {
    "year": {
      "type": "object",
      "required": ["yearTitle", "year", "allMonths", "monthsData"],
      "properties": {
        "yearTitle": { "type": "string" },
        "year": { "type": "string" },
        "allMonths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/monthName" }
        },
        "monthsData": {
          "type": "object",
          "required": [
            "enero",
            "febrero",
            "marzo",
            "abril",
            "mayo",
            "junio",
            "julio",
            "agosto",
            "septiembre",
            "octubre",
            "noviembre",
            "diciembre"
          ],
          "additionalProperties": false,
          "propertyNames": { "$ref": "#/$defs/monthName" },
          "patternProperties": {
            "": { "$ref": "#/$defs/month" }
          }
        }
      }
    },
    "monthName": {
      "type": "string",
      "enum": [
        "enero",
        "febrero",
        "marzo",
        "abril",
        "mayo",
        "junio",
        "julio",
        "agosto",
        "septiembre",
        "octubre",
        "noviembre",
        "diciembre"
      ]
    },
    "month": {
      "type": "object",
      "required": ["monthTitle", "audioData"],
      "properties": {
        "monthTitle": { "type": "string" },
        "audioData": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/episode" }
        }
      }
    },
    "episode": {
      "type": "object",
      "required": [
        "episodeNumber",
        "audioTitle",
        "date",
        "description",
        "audioFile",
        "slug"
      ],
      "properties": {
        "episodeNumber": { "type": "integer", "minimum": 1 },
        "audioTitle": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": { "type": "string", "minLength": 1 },
        "audioFile": { "type": "string", "pattern": "^https://" },
        "slug": { "type": "string", "pattern": "^[0-9a-z-]+$" },
        "duration": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
        "spotifyUrl": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}
